{
  "name": "dsh-workflow-templates",
  "version": "0.1.1",
  "description": "DSH 预置 Workflow 模板库插件：内置 12 个（目标 50+）可复用 workflow 编排脚本模板，提供 wf_template_list / wf_template_search / wf_template_run / wf_template_validate 工具与模板格式静态校验",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "templates",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "workflow",
    "templates",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "compatibility": {
      "node": ">=22.18.0",
      "dsh": ">=0.1.0"
    },
    "permissions": {
      "summary": "预置 workflow 模板库：wf_template_list/search/run/validate 四个工具，模板内容交给官方 workflow 工具发起；模板格式静态校验。不执行模板脚本本身，仅交官方 workflow 引擎。",
      "commands": [
        "node <pkg>/lib/*.js (template list/search/validate in-process)",
        "官方 workflow 工具发起（宿主）"
      ],
      "writePaths": [
        "（无；仅读模板与输出渲染）"
      ],
      "externalServices": [],
      "failureBoundaries": [
        "模板静态校验失败报错",
        "workflow 工具不可见时提示"
      ],
      "lifecycleEvidence": [
        "全部断言通过（12 模板 INDEX 一致）"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx tests/smoke.e2e.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/988hj7tczd-oss/dsh-workflow-templates.git"
  }
}
